# QuestMaster: строки журнала скрипта (журнал PhoeCord и questmaster.log) и уведомления.
qm-file-path = [System] Журнал пишется в файл: { $path }
qm-session-start = === Сеанс QuestMaster { $version } начат ===
qm-timer-failed = [System] Не удалось поставить таймер: { $error }
qm-fatal = [System] ОШИБКА: { $error }
qm-all-completed = [System] Все доступные задания выполнены!
qm-no-selection = [System] Задания не выбраны. Завершение работы.
qm-picker = [System] Готово заданий: { $count }. Запуск: `/phoecord quests start` (все) или `/phoecord quests start <id задания>`.
qm-picker-item = { $id }: { $name } ({ $type }, { $label }: { $reward })
qm-loop-start = [Cycle] Запуск цикла №{ $n }...
qm-loop-error = [Cycle] Ошибка в цикле №{ $n }: { $error }
qm-loop-random = [Cycle] Цикл №{ $n } завершён. Случайная пауза: { $min } мин до повторной проверки.
qm-loop-wait = [Cycle] Цикл №{ $n } завершён. Пауза до повторной проверки...
qm-failed-skipped = [System] Выбранные задания не удались или пропущены. Проверьте журнал и выполните `/phoecord quests retry`.
qm-claim-above = [System] Цикл заданий завершён. Заберите награды командой `/phoecord quests claim <id задания>`, затем выполните `/phoecord quests stop`.
qm-cycle-finished = [System] Цикл завершён. Если прогресс в Discord застрял на 0%, подождите или выполните `/phoecord quests retry`.
qm-stopping = [System] Остановка скрипта и очистка...
qm-invalid-config = [Quest] У задания { $id } неверная конфигурация. Пропуск.
qm-unknown-type = [Quest] Неизвестный тип задания: { $name }
qm-invalid-target = [Quest] Неверная цель ({ $target }) у { $id }. Пропуск.
qm-processing = [Cycle] В работе: видео { $videos } (×{ $vlimit }), игр { $games } (×{ $glimit }).
qm-enroll-accept = [Enroll] Принимаю задание: { $name }
qm-enroll-accept-id = [Enroll] Принимаю задание { $id }…
qm-enroll-unavailable = [Enroll] { $name } недоступно ({ $status }). Пропуск.
qm-enroll-failed = [Enroll] Не удалось для { $name }: { $error }
qm-task-aborted = [Task] Прервано "{ $name }": { $reason }
qm-reason-timeout = Превышено время ожидания
qm-reason-timeout-25 = Превышено время ожидания (25 мин)
qm-reason-client = Ошибка клиента { $status }
qm-reason-network = Слишком много сетевых ошибок
qm-reason-enroll = Не удалось принять задание
qm-reason-no-voice = Голосовой канал не найден
qm-reason-cannot = Невозможно выполнить автоматически
qm-video-start = [Task] ВИДЕО "{ $name }" { $cur }/{ $target } с (ограничение по времени принятия включено)
qm-video-progress = [Task] ВИДЕО "{ $name }": { $cur }/{ $target } с
qm-video-enroll-failed = [Video] Не удалось принять (HTTP { $status }): { $error }
qm-video-http = [Video] Прогресс: HTTP { $status }: { $error }
qm-video-reenrolled = [Video] Задание принято заново, повтор…
qm-fetch-game-fallback = [FetchGame] Запасной вариант для { $name }: HTTP { $status } { $error }
qm-progress = [Task] { $name }: { $cur }/{ $target } с
qm-progress-api = [Task] { $name }: { $cur }/{ $target } с (api)
qm-soft-heartbeat = [Task] Мягкий heartbeat { $key } → HTTP { $status } (пропущено)
qm-achievement-try = [Task] Пробую подделку heartbeat для "{ $name }"...
qm-achievement-rejected = [Achievement] Heartbeat отклонён (HTTP { $status }). Переход в пассивный режим.
qm-achievement-failures = [Achievement] Слишком много ошибок. Переход в пассивный режим.
qm-bypass-non-numeric = [Bypass] Отказ: appId не число "{ $id }".
qm-skip-no-path = [Task] Пропуск "{ $name }": ни один способ автовыполнения не сработал.
qm-activity-unavailable = [Task] Задание с активностью недоступно (HTTP { $status }). Пропуск.
qm-activity-failed = [Task] Heartbeat ACTIVITY не удался ({ $n }/{ $max }): { $error }
qm-activity-final-failed = [ACTIVITY] Последний heartbeat не удался: { $error }
qm-completed = [Task] Выполнено "{ $name }"!
qm-claim-auto = [Claim] Награда за "{ $name }" получена автоматически!
qm-claim-captcha = [Claim] Для "{ $name }" нужна капча. Используйте `/phoecord quests claim { $id }`.
qm-claim-auto-failed = [Claim] Автополучение не удалось для "{ $name }": { $error }
qm-claim-ok = [Claim] Награда за "{ $name }" получена!
qm-claim-action = [Claim] Для "{ $name }" нужно действие. Проверьте капчу в Discord.
qm-net-retry = [Network] Повтор { $n }/{ $max } через { $secs } с (HTTP { $status })
qm-net-client = [Network] HTTP { $status }: { $url }
qm-net-failed = [Network] Запрос к { $url } не удался: { $error }
qm-notify-title = QuestMaster
qm-notify-completed = QuestMaster: задание выполнено
qm-notify-none = QuestMaster не нашёл невыполненных заданий.
qm-notify-failed = QuestMaster: задания не удались или пропущены. Проверьте журнал и повторите.
qm-notify-stopped = QuestMaster остановлен: { $error }
qm-game-spoofed = [Task] Подделана ИГРА { $name }: её присутствие и десктопные heartbeat уходят в сеть.
qm-stream-spoofed = [Task] Подделан СТРИМ для { $name }. Зайдите в голосовой канал, где есть хотя бы 1 человек, и транслируйте любое окно.
qm-desktop-beat-refused = [Task] { $name }: heartbeat в формате клиента отклонён (HTTP { $status }); дальше только мягкие heartbeat.
qm-bypass-snapshot-failed = [Bypass] Не удалось снять список выданных доступов; отмена: { $error }
qm-bypass-trying = [Bypass] Пробую авторизацию через Discord Says для "{ $name }"...
qm-consent-ask = [Bypass] Авторизовать приложение { $app }? Права: { $scopes }. Сервер приложения получит настоящий код авторизации; QuestMaster отзовёт доступ сразу после задания. Санкции Discord за автоматизацию заданий могут затронуть весь аккаунт. Ответьте в течение 60 с: `/phoecord quests consent { $id }` (или `consent-always { $id }`, чтобы не спрашивать до конца сеанса), `/phoecord quests deny` для отмены.
qm-consent-title = QuestMaster: авторизовать приложение?
qm-consent-notify = { $app } просит OAuth-авторизацию для задания с достижением. Ответьте в течение 60 с: `/phoecord quests consent { $id }` или `/phoecord quests deny`.
qm-consent-declined = [Bypass] Для "{ $name }" согласие не дано. Приложение не авторизуется.
qm-bypass-success = [Bypass] Успех: "{ $name }" выполнено через Discord Says.
qm-bypass-age-gated = [Bypass] "{ $name }" нельзя запустить (возрастное ограничение или снято с витрины). Discord блокирует proxy ticket.
qm-bypass-failed = [Bypass] Не удалось: { $error }
qm-bypass-cleanup-failed = [Bypass] Отзыв доступа не удался (не критично): { $error }

# Settings tab labels (2.4.2)
setting-auto-enroll = Записываться на новые задания
setting-auto-start = Запускать записанные задания
setting-auto-claim = Забирать награды
setting-random-delay = Случайные задержки
setting-concurrent-games = Игровых заданий одновременно
setting-concurrent-videos = Видео-заданий одновременно
setting-hide-activity = Скрывать подставную игру
setting-file-logging = Писать файл журнала
