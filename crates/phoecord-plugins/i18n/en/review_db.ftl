# ReviewDB: answer of `/phoecord reviews`.
review_db-header = **Reviews of { $user }: { $count }**
review_db-line = { $who }{ $when }: { $text }
review_db-notice = -# { $text }
review_db-none = No reviews yet.
review_db-next = More: `/phoecord reviews user:{ $user } page:{ $page }`
review_db-cut = (cut to fit Discord's 2000 characters)
review_db-opted-out = This user has opted out of ReviewDB.
review_db-too-fast = You are sending requests too fast. Wait a few seconds and try again.
review_db-failed = An Error occured while fetching reviews. Please try again later.
review_db-bad-user = Not a user id or mention.
review_db-bad-page = `page` must be a number, 1 or more.

