# petpet: answers of `/phoecord petpet` (Vencord's wording where it has one).
petpet-no-image = No Image specified!
petpet-delay = Delay must be at least 20.
petpet-resolution = Resolution must be a number from 1 to 512.
petpet-bad-url = Only Discord image links work: cdn.discordapp.com or media.discordapp.net.
petpet-bad-user = Not a user id or mention.
petpet-user-failed = Failed to fetch user: { $error }
petpet-failed = Could not make the petpet: { $error }
