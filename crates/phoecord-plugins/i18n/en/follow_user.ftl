# FollowUser: the script's toasts, written to the log.
follow-joined = Followed user into a new voice channel
follow-full = Channel is full
follow-same = You are already in the same channel
follow-left = Followed user left, disconnected
follow-left-stay = Followed user left, but not following disconnect
follow-not-in-voice = Followed user is not in a voice channel

# Settings tab labels (2.4.2)
setting-follow-user-id = User id to follow
setting-execute-on-follow = Join their channel as soon as you follow
setting-follow-leave = Leave when they leave
setting-auto-move-back = Move back when moved away
setting-only-manual-trigger = Only follow when asked
