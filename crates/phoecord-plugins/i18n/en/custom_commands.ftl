# CustomCommands: answers of `/phoecord tags` and `/phoecord tag` (Vencord's wording where it
# has one).
custom_commands-none = Woops! There are no tags yet, use `/phoecord tags action:create` to create one!
custom_commands-missing = A Tag with the name **{ $name }** does not exist!
custom_commands-deleted = Successfully deleted the tag **{ $name }**!
custom_commands-created = Created the tag **{ $name }**.
custom_commands-overwritten = A tag with the name **{ $name }** already existed and was overwritten.
custom_commands-need-name-and-message = Give both `name` and `message` to create a tag.
custom_commands-reserved = The argument name "ephemeral" is reserved and cannot be used.
custom_commands-bad-action = Unknown action `{ $action }`. Use create, list or delete.
custom_commands-send-failed = Could not send the tag: { $error }
