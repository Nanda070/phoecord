# RelationshipNotifier: desktop notifications when someone leaves your life.
friend-removed-title = Friend removed
friend-removed = { $who } is no longer your friend.
request-cancelled-title = Friend request cancelled
request-cancelled = { $who } cancelled their friend request.
request-declined-title = Friend request declined
request-declined = { $who } declined your friend request.
guild-removed-title = Removed from a server
guild-removed = You're no longer in { $name }. You were kicked or banned, or it was deleted.
group-removed-title = Removed from a group
group-removed = You were removed from { $name }.
unknown-user = user { $id }
unknown-guild = server { $id }
unknown-group = a group DM

# Settings tab labels (2.4.2)
setting-friends = Friend removals
setting-friend-requests = Cancelled friend requests
setting-servers = Server removals
setting-groups = Group removals
