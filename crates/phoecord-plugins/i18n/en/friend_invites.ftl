# FriendInvites: answers of `/phoecord create-friend-invite`, `view-friend-invites` and
# `revoke-friend-invites` (Vencord's wording).
friend_invites-created = discord.gg/{ $code } · Expires: { $expires } · Max uses: `{ $max }`
friend_invites-line = _discord.gg/{ $code }_ · Expires: { $expires } · Times used: `{ $uses }/{ $max }`
friend_invites-never = never
friend_invites-none = You have no active friend invites!
friend_invites-revoked = All friend invites have been revoked.
friend_invites-failed = Could not reach Discord: { $error }
