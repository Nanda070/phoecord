# QuestMaster: the script's log lines (PhoeCord log and questmaster.log) and notifications.
qm-file-path = [System] Logging to file: { $path }
qm-session-start = === QuestMaster { $version } session start ===
qm-timer-failed = [System] Could not set a timer: { $error }
qm-fatal = [System] FATAL: { $error }
qm-all-completed = [System] All available quests are completed!
qm-no-selection = [System] No quests selected. Shutting down.
qm-picker = [System] { $count } quests ready. Start them with `/phoecord quests start` (all) or `/phoecord quests start <quest id>`.
qm-picker-item = { $id }: { $name } ({ $type }, { $label }: { $reward })
qm-loop-start = [Cycle] Starting loop #{ $n }...
qm-loop-error = [Cycle] Error in loop #{ $n }: { $error }
qm-loop-random = [Cycle] Loop #{ $n } complete. Random delay: { $min }m before rescan.
qm-loop-wait = [Cycle] Loop #{ $n } complete. Waiting before rescan...
qm-failed-skipped = [System] Selected quests failed or were skipped. Check the log, then run `/phoecord quests retry`.
qm-claim-above = [System] Quest cycle finished. Claim your rewards with `/phoecord quests claim <quest id>`, then run `/phoecord quests stop`.
qm-cycle-finished = [System] Cycle finished. If progress stuck at 0% in Discord, wait or run `/phoecord quests retry`.
qm-stopping = [System] Stopping script & cleaning up...
qm-invalid-config = [Quest] { $id } has invalid task config. Skipping.
qm-unknown-type = [Quest] Unknown task type: { $name }
qm-invalid-target = [Quest] Invalid target ({ $target }) for { $id }. Skipping.
qm-processing = [Cycle] Processing: { $videos } videos (×{ $vlimit }), { $games } games (×{ $glimit }).
qm-enroll-accept = [Enroll] Accepting quest: { $name }
qm-enroll-accept-id = [Enroll] Accepting quest { $id }…
qm-enroll-unavailable = [Enroll] { $name } unavailable ({ $status }). Skipping.
qm-enroll-failed = [Enroll] Failed for { $name }: { $error }
qm-task-aborted = [Task] Aborted "{ $name }": { $reason }
qm-reason-timeout = Timeout exceeded
qm-reason-timeout-25 = Timeout exceeded (25m)
qm-reason-client = Client Error { $status }
qm-reason-network = Too many network failures
qm-reason-enroll = Enrollment failed
qm-reason-no-voice = No voice channel found
qm-reason-cannot = Cannot auto-complete
qm-video-start = [Task] VIDEO "{ $name }" { $cur }/{ $target }s (enrolled rate-limit on)
qm-video-progress = [Task] VIDEO "{ $name }": { $cur }/{ $target }s
qm-video-enroll-failed = [Video] Enroll failed (HTTP { $status }): { $error }
qm-video-http = [Video] progress HTTP { $status }: { $error }
qm-video-reenrolled = [Video] Re-enrolled, retrying…
qm-fetch-game-fallback = [FetchGame] Fallback for { $name }: HTTP { $status } { $error }
qm-progress = [Task] { $name }: { $cur }/{ $target }s
qm-progress-api = [Task] { $name }: { $cur }/{ $target }s (api)
qm-soft-heartbeat = [Task] Soft heartbeat { $key } → HTTP { $status } (ignored)
qm-achievement-try = [Task] Attempting heartbeat spoofing for "{ $name }"...
qm-achievement-rejected = [Achievement] Heartbeat rejected (HTTP { $status }). Falling back to passive mode.
qm-achievement-failures = [Achievement] Too many failures. Falling back to passive mode.
qm-bypass-non-numeric = [Bypass] Refusing non-numeric appId "{ $id }".
qm-skip-no-path = [Task] Skipping "{ $name }" — no auto-completion path worked.
qm-activity-unavailable = [Task] Activity quest unavailable (HTTP { $status }). Skipping.
qm-activity-failed = [Task] ACTIVITY heartbeat failed ({ $n }/{ $max }): { $error }
qm-activity-final-failed = [ACTIVITY] Final heartbeat failed: { $error }
qm-completed = [Task] Completed "{ $name }"!
qm-claim-auto = [Claim] Reward for "{ $name }" claimed automatically!
qm-claim-captcha = [Claim] Captcha required for "{ $name }". Use `/phoecord quests claim { $id }`.
qm-claim-auto-failed = [Claim] Auto-claim failed for "{ $name }": { $error }
qm-claim-ok = [Claim] Reward for "{ $name }" claimed successfully!
qm-claim-action = [Claim] Action required for "{ $name }". Check Discord UI for captcha.
qm-net-retry = [Network] Retry { $n }/{ $max } in { $secs }s (HTTP { $status })
qm-net-client = [Network] HTTP { $status }: { $url }
qm-net-failed = [Network] Request to { $url } failed: { $error }
qm-notify-title = QuestMaster
qm-notify-completed = QuestMaster: Quest Completed
qm-notify-none = QuestMaster found no incomplete quests.
qm-notify-failed = QuestMaster: quests failed/skipped. Check logs and retry.
qm-notify-stopped = QuestMaster stopped: { $error }
qm-game-spoofed = [Task] Spoofed GAME { $name }: its presence and desktop heartbeats go out on the wire.
qm-stream-spoofed = [Task] Spoofed STREAM for { $name }. Join a VC with ≥1 person and stream any window.
qm-desktop-beat-refused = [Task] { $name }: the client-shaped heartbeat was refused (HTTP { $status }); soft heartbeats from now on.
qm-bypass-snapshot-failed = [Bypass] Couldn't snapshot existing grants; aborting: { $error }
qm-bypass-trying = [Bypass] Trying Discord Says auth flow for "{ $name }"...
qm-consent-ask = [Bypass] Authorize application { $app }? Scopes: { $scopes }. The app's backend receives a real authorization code; QuestMaster revokes the grant right after the quest. Discord enforcement against quest automation can affect the whole account. Answer within 60 s: `/phoecord quests consent { $id }` (or `consent-always { $id }` to not ask again this session), `/phoecord quests deny` to cancel.
qm-consent-title = QuestMaster: authorize application?
qm-consent-notify = { $app } wants OAuth authorization for an achievement quest. Answer within 60 s with `/phoecord quests consent { $id }` or `/phoecord quests deny`.
qm-consent-declined = [Bypass] Consent declined for "{ $name }". Not authorizing the app.
qm-bypass-success = [Bypass] Success — "{ $name }" completed via Discord Says.
qm-bypass-age-gated = [Bypass] "{ $name }" can't be launched (age-gated or delisted). Discord blocks the proxy ticket.
qm-bypass-failed = [Bypass] Failed: { $error }
qm-bypass-cleanup-failed = [Bypass] Deauthorize cleanup non-fatal: { $error }

