# CustomRPC: answers of `/phoecord rpc`.
custom_rpc-shown = Custom Rich Presence updated.
custom_rpc-cleared = Custom Rich Presence is off (no `appName`, or `enablePresence = false`), removed from your status.
custom_rpc-no-presence = No presence seen yet. Change your status or press Ctrl+R, then try again.

# Settings tab labels (2.4.2)
setting-enable-presence = Show the custom activity
setting-app-i-d = Application id
setting-app-name = Application name
setting-type = Activity type: 0 playing, 1 streaming, 2 listening, 3 watching, 5 competing
setting-details = Details line
setting-details-u-r-l = Details link
setting-state = State line
setting-state-u-r-l = State link
setting-stream-link = Stream link (Twitch or YouTube)
setting-timestamp-mode = Timestamp: 0 none, 1 since start, 2 time of day, 3 custom
setting-start-time = Custom start time, ms
setting-end-time = Custom end time, ms
setting-image-big = Large image
setting-image-big-tooltip = Large image tooltip
setting-button-one-text = First button text
setting-button-one-u-r-l = First button link
setting-button-two-text = Second button text
setting-button-two-u-r-l = Second button link
setting-party-size = Party size
