---
import { t, type Lang } from "../i18n";
import { getRelease, REPO } from "../lib/release";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).downloadPage;
const r = await getRelease();
---
<section class="page-head">
  <div class="wrap">
    <h1>{s.title}</h1>
    <p>{s.lead}</p>
  </div>
</section>

<div class="wrap">
  <div class="os-grid">
    <div class="os" data-os="windows">
      <h2>{s.os.windows.name}</h2>
      <p class="note">{s.os.windows.note}</p>
      <a class="btn btn-primary" href={r.assets.windows}>{s.os.windows.button}</a>
    </div>
    <div class="os" data-os="macos">
      <h2>{s.os.macos.name}</h2>
      <p class="note">{s.os.macos.note}</p>
      <a class="btn btn-primary" href={r.assets.macosArm}>{s.os.macos.arm}</a>
      <a class="btn btn-ghost" href={r.assets.macosIntel}>{s.os.macos.intel}</a>
    </div>
    <div class="os" data-os="linux">
      <h2>{s.os.linux.name}</h2>
      <p class="note">{s.os.linux.note}</p>
      <a class="btn btn-primary" href={r.assets.deb}>{s.os.linux.deb}</a>
      <a class="btn btn-ghost" href={r.assets.rpm}>{s.os.linux.rpm}</a>
    </div>
  </div>
  <p class="meta">
    {r.tag && <>{s.release} <a href={r.url}>{r.tag}</a> · </>}
    <a href={r.url}>{s.allFiles}</a> · {s.verify}
  </p>

  <section class="section">
    <h2>{s.stepsTitle}</h2>
    <ol class="steps">
      {s.steps.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section class="section two">
    <div>
      <h2>{s.cliTitle}</h2>
      <p class="muted">{s.cliText}</p>
      <pre class="code">{`git clone ${REPO}
cd phoecord
cargo run --release -- setup`}</pre>
    </div>
    <div>
      <h2>{s.uninstallTitle}</h2>
      <p class="muted">{s.uninstallText}</p>
      <pre class="code">phoecord uninstall</pre>
    </div>
  </section>
</div>

<script>
  const ua = navigator.userAgent;
  const os = /Windows/i.test(ua) ? "windows" : /Mac/i.test(ua) ? "macos" : /Linux|X11/i.test(ua) ? "linux" : null;
  if (os) document.querySelector(`.os[data-os="${os}"]`)?.classList.add("current");
</script>
