---
import { t, type Lang } from "../i18n";
import { WIKI } from "../lib/wiki";
import { inline } from "../lib/richtext";
import { REPO } from "../lib/release";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const p = s.wikiPage;
const groups = WIKI[lang];
---
<div class="wrap wiki">
  <aside class="wiki-toc" aria-label={p.contents}>
    <p class="toc-title">{p.contents}</p>
    {groups.map((g) => (
      <div class="toc-group">
        <p class="toc-group-title">{g.title}</p>
        <ul>
          {g.sections.map((sec) => <li><a href={`#${sec.id}`}>{sec.title}</a></li>)}
        </ul>
      </div>
    ))}
  </aside>

  <article class="wiki-body">
    <header class="doc-hero">
      <h1>{p.title}</h1>
      <p class="doc-lead">{p.lead}</p>
    </header>

    {groups.map((g) => (
      <>
        <p class="wiki-group">{g.title}</p>
        {g.sections.map((sec) => (
          <section class="wiki-sec" id={sec.id}>
            <h2><a class="anchor" href={`#${sec.id}`} aria-label={sec.title}>#</a>{sec.title}</h2>
            {sec.blocks.map((b) => {
              if ("p" in b) return <p set:html={inline(b.p)} />;
              if ("note" in b) return <p class="wiki-note" set:html={inline(b.note)} />;
              if ("code" in b) return <pre><code>{b.code}</code></pre>;
              if ("ul" in b) return <ul>{b.ul.map((i) => <li set:html={inline(i)} />)}</ul>;
              if ("ol" in b) return <ol>{b.ol.map((i) => <li set:html={inline(i)} />)}</ol>;
              return (
                <div class="wiki-table">
                  <table>
                    <thead><tr>{b.table.head.map((h) => <th set:html={inline(h)} />)}</tr></thead>
                    <tbody>{b.table.rows.map((r) => <tr>{r.map((c) => <td set:html={inline(c)} />)}</tr>)}</tbody>
                  </table>
                </div>
              );
            })}
          </section>
        ))}
      </>
    ))}

    <p class="wiki-foot">{p.editHint} <a href={REPO} rel="noopener">GitHub</a> · <a href="#top">{p.top}</a></p>
  </article>
</div>
